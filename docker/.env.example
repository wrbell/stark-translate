# Template — copy to .env and edit. Loaded automatically by `docker compose up`.
#
# Most operators only need to set STARK_MODELS_DIR. Everything else has sane
# defaults baked into docker-compose.yml.

# --- Image tag --------------------------------------------------------------
# Pin to a specific GHCR tag in production; latest is the dev default.
TAG=latest

# --- Models + session data ---------------------------------------------------
# Where GGUFs / Whisper / Piper voices live on the host. Bind-mounted RO into
# both services. Run `stark-translate setup` (PyPI install) to populate it,
# or copy GGUFs in manually.
STARK_MODELS_DIR=/home/operator/.cache/stark-translate/models

# Where session CSVs / WAVs / metric logs land. Mounted RW into the operator.
STARK_DATA_DIR=/home/operator/.local/share/stark-translate/sessions

# --- Engine selection --------------------------------------------------------
# auto | llamacpp | hf — auto picks llamacpp when llama-server is healthy.
STARK_ENGINE=auto

# --- Audio (PulseAudio passthrough) -----------------------------------------
# UID-aware Pulse socket. If your UID is not 1000, change /run/user/1000 →
# /run/user/<your-uid> AND adjust the volume mount in docker-compose.yml.
PULSE_SERVER=unix:/run/user/1000/pulse/native

# Set to 1 to skip PulseAudio entirely. Then run with the audio-bridge
# profile: `docker compose --profile audio-bridge up`.
# STARK_NO_PULSE=1

# --- Logging -----------------------------------------------------------------
# uvicorn log level for the operator (debug | info | warning | error)
STARK_LOG_LEVEL=info

# --- Optional API keys (training only — the operator never calls these) -----
# STARK_DEEPGRAM__API_KEY=
# STARK_DEEPL__API_KEY=
